{
  "seed": 42,
  "horizon": 600,
  "duration": 500,
  "warmup_time": 30,
  "user_policy": {
    "weights": [0.30, 0.30, 0.40 ],
    "data": [ "ignore", "like", "repost" ]
  },
  "user_inter_action": {
    "exponential": {
      "mean": 0.1
    }
  },
  "warmup_post_inter_creation": {
    "uniform": {
      "min": 0,
      "max": 30,
      "interval": "oc"
    }
  },
  "propagation_delay": {
    "constant": {
      "value": 1
    }
  },
  "interaction_delay": {
    "constant": {
      "value": 1
    }
  },
  "creation_delay": {
    "constant": {
      "value": 1
    }
  },
  "offline_startup_ratio": 0.5,
  "trace_to_file": true
}
