-- sessions.sql
-- One row per session: start/end times, duration, boredom flag,
-- and per-session action counts (likes, reposts, ignores).

COPY (
  WITH
  session_events AS (
    SELECT
      regexp_extract(filename, '/(\d+)-', 1)::INTEGER AS run_id,
      user_id,
      type,
      time,
      backlog
    FROM read_json('{{.TracesDir}}/*-session_trace.jsonl', filename=true, ignore_errors=true)
  ),

  starts AS (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY run_id, user_id ORDER BY time) AS n
    FROM session_events WHERE type = 'start'
  ),

  ends AS (
    SELECT *, ROW_NUMBER() OVER (PARTITION BY run_id, user_id ORDER BY time) AS n
    FROM session_events WHERE type = 'end'
  ),

  paired AS (
    SELECT
      s.run_id,
      s.user_id,
      s.n        AS session_num,
      s.time     AS start_time,
      e.time     AS end_time,
      e.time - s.time AS duration,
      e.backlog  AS end_backlog
    FROM starts s
    JOIN ends e ON s.run_id = e.run_id AND s.user_id = e.user_id AND s.n = e.n
  ),

  actions AS (
    SELECT
      regexp_extract(filename, '/(\d+)-', 1)::INTEGER AS run_id,
      user_id,
      type,
      time
    FROM read_json('{{.TracesDir}}/*-action_trace.jsonl', filename=true, ignore_errors=true)
  )

  SELECT
    p.run_id,
    p.user_id,
    p.session_num,
    p.start_time,
    p.end_time,
    p.duration,
    p.end_backlog == 0 AS ended_by_boredom,
    COUNT(a.type)                         AS total_actions,
    COUNT(a.type) FILTER (WHERE a.type = 'like')   AS total_likes,
    COUNT(a.type) FILTER (WHERE a.type = 'repost') AS total_reposts,
    COUNT(a.type) FILTER (WHERE a.type = 'ignore') AS total_ignores
  FROM paired p
  LEFT JOIN actions a
    ON p.run_id = a.run_id
    AND p.user_id = a.user_id
    AND a.time >= p.start_time
    AND a.time <= p.end_time
  GROUP BY p.run_id, p.user_id, p.session_num, p.start_time, p.end_time, p.duration, p.end_backlog
  ORDER BY p.run_id, p.user_id, p.session_num

) TO '{{.OutputDir}}/sessions.parquet' (FORMAT PARQUET);
