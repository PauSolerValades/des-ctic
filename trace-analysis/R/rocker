#!/usr/bin/env bash
# rocker — quick R runner inside the Rocker distrobox container.
# Drop this in your R/ project directory.
#
# Usage:
#   ./rocker run analysis.R        Run an R script
#   ./rocker run -e '1+1'          Run inline R code
#   ./rocker                       Interactive R session
#   ./rocker bash                  Shell inside the container

set -e
DIR="$(cd "$(dirname "$0")" && pwd)"

case "${1:-}" in
  run)
    shift
    if [ "$1" = "-e" ]; then
      shift
      distrobox enter rocker -- bash -c "cd '$DIR' && Rscript --no-init-file -e '$*'"
    else
      distrobox enter rocker -- bash -c "cd '$DIR' && Rscript --no-init-file $*"
    fi
    ;;
  "")
    distrobox enter rocker -- bash -c "cd '$DIR' && R --no-init-file"
    ;;
  *)
    distrobox enter rocker -- "$@"
    ;;
esac
